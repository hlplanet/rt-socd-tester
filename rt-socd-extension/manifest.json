{
  "manifest_version": 3,
  "name": "Rapid Trigger & SOCD Tester by HLPlanet",
  "short_name": "RT & SOCD",
  "version": "1.0.0",
  "description": "Test rapid trigger tap speed and SOCD / Snap Tap on Hall effect and TMR keyboards. Works offline, collects no data.",
  "homepage_url": "https://www.hlplanet.com/online-keyboard-tester-tool/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Rapid Trigger & SOCD Tester",
    "default_popup": "tester.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rt-socd-tester@hlplanet.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
